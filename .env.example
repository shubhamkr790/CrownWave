# Database
DATABASE_URL=postgresql+asyncpg://cronwave:cronwave@localhost:5432/cronwave
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SEC=2
WORKER_HEARTBEAT_INTERVAL_SEC=30
WORKER_HEARTBEAT_TIMEOUT_SEC=90
WORKER_CLAIM_BATCH_SIZE=5

# Scheduler
SCHEDULER_TICK_INTERVAL_SEC=15

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
